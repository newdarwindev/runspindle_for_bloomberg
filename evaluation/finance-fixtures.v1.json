        "gross_margin_usd": ["sub", "$quote_usd", "$supplier_cost_usd"]
      },
      "when": ["gt", "$gross_margin_usd", "0"],
      "if_true": "stage_draft",
      "if_false": "pass",
      "assumptions": "The $18 per tonne premium is the stated quote less settlement; both holds are valid in this synthetic branch."
    },
    {
      "id": 2,
